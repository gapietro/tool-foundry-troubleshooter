{
  "name": "x-snc-troubleshoot",
  "version": "2026.08.1309",
  "description": "",
  "license": "UNLICENSED",
  "imports": {
    "#now:*": "./@types/servicenow/fluent/*/index.js"
  },
  "scripts": {
    "build": "now-sdk build",
    "deploy": "now-sdk install",
    "transform": "now-sdk transform",
    "types": "now-sdk dependencies",
    "test": "jest",
    "smoke": "node scripts/smoke.js",
    "lint": "eslint ."
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "globalSetup": "<rootDir>/test/_coverageSetup.js",
    "collectCoverageFrom": [
      "src/server/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 83,
        "functions": 93,
        "lines": 92
      },
      "src/server/rest/**/*.js": {
        "statements": 95,
        "branches": 88,
        "functions": 95,
        "lines": 97
      },
      "src/server/async/**/*.js": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "babel-plugin-istanbul": "^6.1.1",
    "@servicenow/glide": "27.0.5",
    "@servicenow/sdk": "4.9.2",
    "eslint": "^9.39.5",
    "jest": "29.7.0",
    "typescript": "5.5.4"
  }
}
